#!/usr/bin/env bash
#
# Rejects a commit whose subject does not start with one of the four emoji from
# docs/adr/0004-commit-message-convention.md.
#
# Install with `make hooks` — git does not carry hooks through a clone.
set -euo pipefail

msg_file="$1"
# The subject is the first line. Comments and the diff that `git commit -v`
# appends are below it, so nothing else needs stripping.
subject=$(head -n1 "$msg_file")

# A merge or a revert that git wrote itself is left alone: the subject is
# generated, and blocking it would mean editing a message nobody chose.
case "$subject" in
Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

# An empty subject means the commit is being aborted anyway; let git say so
# rather than reporting a convention error over the top of it.
[ -z "${subject// /}" ] && exit 0

# 🛠️ is emoji + variation selector (U+FE0F); it is commonly typed without.
# Both are accepted rather than failing on an invisible code point.
if printf '%s' "$subject" | grep -qP '^(🔥|✨|🛠️?|🐛) \S'; then
	exit 0
fi

cat >&2 <<'EOF'
Commit rejected: the subject must start with one of these, then a space.

  🔥  breaking change   (major)
  ✨  major change      (major)
  🛠️  minor change      (minor)
  🐛  bug fix           (patch)

Yours was:
EOF
printf '  %s\n\n' "$subject" >&2
echo "See docs/adr/0004-commit-message-convention.md." >&2
exit 1
